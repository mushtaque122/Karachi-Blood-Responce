# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=karachi_blood_response

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENV=development

# Optional — Notification Engine external channels. Leave unset and
# those channels simply report FAILED with a clear reason instead of
# pretending to send (see app/core/notifications/).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional — AI Agent (Phase 10/11). Leave unset and /api/ai/chat
# returns a clear 503 instead of pretending to respond.
ANTHROPIC_API_KEY=
